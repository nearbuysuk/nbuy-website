---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.name} — ${siteConfig.tagline}`,
  description = siteConfig.description,
} = Astro.props;

const legalDocs = (await getCollection('legals')).sort(
  (a, b) => a.data.order - b.data.order
);

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand-link" href={withBase('/')}>
          <span class="brand-mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </span>
          <span>{siteConfig.name}</span>
        </a>

        <nav aria-label="Primary">
          <ul class="nav-list">
            {
              siteConfig.nav.map((item) => {
                const resolvedHref = withBase(item.href);
                const isCurrent =
                  item.href === '/legals/' && currentPath.includes('/legals');
                return (
                  <li>
                    <a
                      class="nav-link"
                      href={resolvedHref}
                      aria-current={isCurrent ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
            <li>
              <a class="btn btn-primary" href={`mailto:${siteConfig.contactEmail}?subject=nBuy%20Retailer%20Pilot%20Inquiry`}>
                Partner Inquiry
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="brand-link" href={withBase('/')}>
              <span class="brand-mark" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </span>
              <span>{siteConfig.name}</span>
            </a>
            <p style="margin-block-start: 0.75rem; max-inline-size: 28rem;">
              {siteConfig.description}
            </p>
          </div>

          <nav aria-label="Platform Navigation">
            <h2 style="font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; margin-block-end: 0.75rem;">
              Platform
            </h2>
            <ul class="footer-links">
              <li><a href={withBase('/#how-it-works')}>How {siteConfig.name} Works</a></li>
              <li><a href={withBase('/#for-retailers')}>For Local Retailers</a></li>
              <li><a href={withBase('/#ecosystem')}>Retailer &amp; Consumer Flow</a></li>
              <li><a href={`mailto:${siteConfig.contactEmail}`}>Retailer Pilot Contact</a></li>
            </ul>
          </nav>

          <nav aria-label="Legal Documentation">
            <h2 style="font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; margin-block-end: 0.75rem;">
              Legals &amp; Policies
            </h2>
            <ul class="footer-links">
              <li><a href={withBase('/legals/')}>All Legal Documents</a></li>
              {
                legalDocs.map((doc) => (
                  <li>
                    <a href={withBase(`/legals/${doc.id}/`)}>{doc.data.title}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <div class="footer-bottom">
          <p>&copy; {siteConfig.lastUpdatedYear} {siteConfig.name}. All rights reserved.</p>
          <p>Status: <strong style="color: var(--color-text-primary);">{siteConfig.statusBadge}</strong></p>
        </div>
      </div>
    </footer>
  </body>
</html>

