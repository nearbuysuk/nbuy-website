---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const legalDocs = await getCollection('legals');
  return legalDocs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);

const allDocs = (await getCollection('legals')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title={`${doc.data.title} — ${siteConfig.name}`}
  description={doc.data.summary}
>
  <div class="section">
    <div class="container legal-layout">
      <aside class="legal-sidebar no-print" aria-label="Legal documents navigation">
        <a class="back-link" href={withBase('/legals/')}>
          &larr; All Legal Documents
        </a>

        <nav class="sidebar-nav" aria-label="Switch legal policy">
          <h2 class="sidebar-heading">Policies</h2>
          <ul class="sidebar-list">
            {
              allDocs.map((item) => {
                const isActive = item.id === doc.id;
                return (
                  <li>
                    <a
                      class="sidebar-link"
                      href={withBase(`/legals/${item.id}/`)}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      <span>{item.data.title}</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </aside>

      <article class="legal-article">
        <header class="legal-article-header">
          <div class="meta-pills">
            <span class="badge">{doc.data.audience}</span>
            <span class="meta-date">Effective: {doc.data.effectiveDate}</span>
            <span class="meta-date">Last Updated: {doc.data.lastUpdated}</span>
          </div>
          <h1>{doc.data.title}</h1>
          <p class="legal-summary">{doc.data.summary}</p>
        </header>

        <div class="prose">
          <Content />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .legal-layout {
      grid-template-columns: 16rem 1fr;
    }

    .legal-sidebar {
      position: sticky;
      inset-block-start: 5.5rem;
    }
  }

  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    margin-block-end: var(--space-md);
    text-decoration: none;
  }

  .sidebar-nav {
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .sidebar-heading {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-block-end: 0.65rem;
  }

  .sidebar-list {
    list-style: none;
  }

  .sidebar-list li:not(:last-child) {
    margin-block-end: 0.35rem;
  }

  .sidebar-link {
    display: block;
    padding-block: 0.45rem;
    padding-inline: 0.65rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: 0.925rem;
    font-weight: 550;
  }

  .sidebar-link:hover {
    background-color: var(--color-bg-muted);
    color: var(--color-text-primary);
  }

  .sidebar-link[aria-current="page"] {
    background-color: var(--color-brand-soft);
    color: var(--color-brand-primary);
    font-weight: 700;
  }

  .legal-article {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.75rem);
    box-shadow: var(--shadow-sm);
  }

  .legal-article-header {
    padding-block-end: var(--space-lg);
    margin-block-end: var(--space-lg);
    border-block-end: 1px solid var(--color-border-subtle);
  }

  .meta-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    gap: 0.75rem;
    margin-block-end: var(--space-sm);
  }

  .meta-date {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .legal-summary {
    margin-block-start: var(--space-sm);
    font-size: 1.075rem;
  }
</style>

