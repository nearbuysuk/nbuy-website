---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import { withBase } from '../../utils/paths';

const legalDocs = (await getCollection('legals')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title={`Legals & Platform Policies — ${siteConfig.name}`}
  description={`Official legal documentation, privacy policy, terms of service, and retailer terms for ${siteConfig.name}.`}
>
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge">Legal &amp; Compliance Hub</span>
        <h1 style="margin-block-start: 0.75rem;">
          Platform Policies &amp; Legal Agreements
        </h1>
        <p>
          Clear, plain-language legal documentation governing how {siteConfig.name} handles location discovery, consumer reservations, and local retailer listings.
        </p>
      </div>

      <div class="card-grid-3">
        {
          legalDocs.map((doc) => (
            <article class="aligned-card legal-card">
              <div class="legal-card-meta">
                <span class="badge">{doc.data.audience}</span>
                <span class="updated-date">Updated {doc.data.lastUpdated}</span>
              </div>

              <h2>
                <a class="legal-card-title" href={withBase(`/legals/${doc.id}/`)}>
                  {doc.data.title}
                </a>
              </h2>

              <div class="legal-card-footer">
                <p>{doc.data.summary}</p>
                <a class="read-policy-link" href={withBase(`/legals/${doc.id}/`)}>
                  Read {doc.data.shortTitle} &rarr;
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <aside class="legal-contact-box" aria-label="Legal contact information">
        <h2>Questions about our policies or pilot retailer agreements?</h2>
        <p>
          If you are a retail partner or consumer with a question regarding privacy, data handling, or merchant terms, contact our team at{' '}
          <a href={`mailto:${siteConfig.legalEmail}`}>{siteConfig.legalEmail}</a>.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .updated-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .legal-card h2 {
    font-size: 1.35rem;
  }

  .legal-card-title {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .legal-card-title:hover {
    color: var(--color-brand-primary);
  }

  .legal-card-footer {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .read-policy-link {
    font-weight: 650;
    font-size: 0.95rem;
    margin-block-start: auto;
  }

  .legal-contact-box {
    margin-block-start: var(--space-xl);
    padding: var(--space-lg);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }

  .legal-contact-box h2 {
    font-size: 1.2rem;
    margin-block-end: 0.35rem;
  }
</style>

